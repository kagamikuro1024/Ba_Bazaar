NODE_ENV=production

POSTGRES_USER=ba_bazaar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ba_bazaar
DATABASE_URL=postgresql://ba_bazaar:change_me@postgres:5432/ba_bazaar?schema=public

API_PORT=3001
WEB_PORT=3000

JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL_DAYS=30
ALLOW_MOCK_AUTH=false
CORS_ORIGIN=http://YOUR_VPS_IP

VITE_API_BASE_URL=http://YOUR_VPS_IP/api
VITE_ALLOW_MOCK_AUTH=false
VITE_SHOW_DEMO_ACCOUNTS=false

# AI features use DeepSeek's OpenAI-compatible chat completions API.
# Leave DEEPSEEK_API_KEY blank to use deterministic grounded fallbacks.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHBOARD_LLM_TIMEOUT_SECONDS=45
