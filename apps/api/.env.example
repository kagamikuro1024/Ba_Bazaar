API_PORT=3000
WEB_PORT=5173
DATABASE_URL=postgresql://ba_bazaar:change_me@localhost:5432/ba_bazaar?schema=public
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL_DAYS=30
ALLOW_MOCK_AUTH=false

# AI features use DeepSeek's OpenAI-compatible chat completions API.
# Leave DEEPSEEK_API_KEY blank to use deterministic grounded fallbacks.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHBOARD_LLM_TIMEOUT_SECONDS=45
